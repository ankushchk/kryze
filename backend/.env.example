# if you're using neondb then use this
DATABASE_URL="postgresql://postgres:password@localhost:5432/kryze_innoforge?schema=public"
PAYMENT_PROVIDER_MODE="mock"
PUBLIC_API_URL="https://your-public-backend-url.example.com"
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
# Outbound voice call reminders are disabled unless this is explicitly true.
ENABLE_ELEVENLABS_OUTBOUND_CALLS="false"
ELEVENLABS_AGENT_ID="agent_..."
# Uses the existing Twilio number and PUBLIC_API_URL; it does not overwrite Twilio's inbound voice webhook.
# Used only by your external scheduler when it POSTs /api/call-reminders/dispatch.
CALL_REMINDER_CRON_SECRET="use_a_long_random_value"
# Local development only. Production should invoke the protected dispatch endpoint from its scheduler.
ENABLE_LOCAL_CALL_REMINDER_SCHEDULER="false"
OPENAI_API_KEY="your_openai_api_key"
# Optional: defaults to gpt-5
OPENAI_EXPENSE_MODEL="gpt-5"
# Optional: defaults to gpt-5; set this to change receipt OCR quality/speed.
OPENAI_RECEIPT_MODEL="gpt-5"
# Postgres (Docker Compose)
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=5432
# if you're using supabase :)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.rjzxredxxfbkrlmuyabb:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.rjzxredxxfbkrlmuyabb:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
